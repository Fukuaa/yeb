REDIS_HOST=192.168.240.10
REDIS_PORT=6379
# Replace this value with the private REDIS_PASSWORD from the Ubuntu .env file.
REDIS_PASSWORD=replace-with-your-redis-password
DB_PASSWORD=replace-with-your-mysql-password
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=replace-with-your-rabbitmq-password
MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=your-email@qq.com
MAIL_PASSWORD=replace-with-your-smtp-authorization-code
MAIL_FROM=your-email@qq.com
MAIL_AUTH=true
MAIL_STARTTLS=true
MAIL_SSL=false
